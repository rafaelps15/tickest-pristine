{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5440;Database=tickestpristine;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Issuer": "tickestpristine",
    "Audience": "developers",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "Admin": {
    "Email": "admin@tickest.dev",
    "FirstName": "Admin",
    "LastName": "Master"
  },
  "Seeding": {
    "SampleData": true
  },
  "Cors": {
    "AllowLoopbackOrigins": true
  }
}
